{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "recording",
    "acquisition"
  ],
  "properties": {
    "version": {
      "const": 8
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_inputs",
        "_provenance",
        "datetime_provenance"
      ],
      "properties": {
        "active_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "rfid_boards": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "ttl": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9A-P]|TTL[1-4])-[1-9][0-9]*$"
              }
            },
            "device_rfid": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9A-P]|TTL[1-4])-[1-9][0-9]*$"
              }
            }
          }
        },
        "_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acquisition_gui_state_path",
            "diagnostic_log_path"
          ],
          "properties": {
            "acquisition_gui_state_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*[\\\\:]).+$"
            },
            "diagnostic_log_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*[\\\\:]).+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "datetime_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_source",
            "end_source"
          ],
          "properties": {
            "start_source": {
              "type": "string"
            },
            "end_source": {
              "type": "string"
            }
          }
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "project_name",
        "recording_location",
        "notes",
        "timeline",
        "cohort",
        "events",
        "layout",
        "devices"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "project_name": {
          "type": "string"
        },
        "recording_location": {
          "type": "string"
        },
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_datetime",
            "end_datetime",
            "recording_timezone",
            "start_from",
            "phases",
            "end_with"
          ],
          "properties": {
            "start_datetime": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_datetime": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recording_timezone": {
              "type": "string"
            },
            "start_from": {
              "enum": [
                "light_phase",
                "dark_phase"
              ]
            },
            "phases": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light_phase",
                "dark_phase"
              ],
              "properties": {
                "light_phase": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "dark_phase": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                }
              }
            },
            "end_with": {
              "enum": [
                "dark_phase",
                "light_phase"
              ],
              "description": "Downstream analysis end-phase preference only; does not trim or schedule DAQ."
            }
          }
        },
        "cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n_mice",
            "animals"
          ],
          "properties": {
            "n_mice": {
              "type": "integer",
              "minimum": 0
            },
            "animals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tag",
                  "mouse_line",
                  "genotype",
                  "subject_name",
                  "sex",
                  "date_of_birth",
                  "genetic_background",
                  "treatment",
                  "notes",
                  "row_index"
                ],
                "properties": {
                  "tag": {
                    "type": "string"
                  },
                  "mouse_line": {
                    "type": "string"
                  },
                  "genotype": {
                    "type": "string"
                  },
                  "subject_name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sex": {
                    "type": "string"
                  },
                  "date_of_birth": {
                    "type": "string"
                  },
                  "genetic_background": {
                    "type": "string"
                  },
                  "treatment": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  },
                  "row_index": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "bouts"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "bouts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end",
                    "position"
                  ],
                  "properties": {
                    "start": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "end": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "(Z|[+-]\\d{2}:\\d{2})$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "position": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true,
                      "minItems": 1,
                      "description": "Selected compartment names, or null when no position is specified."
                    }
                  }
                }
              },
              "devices": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cages",
            "tunnels",
            "junctions",
            "antenna_combinations",
            "tunnels_map"
          ],
          "properties": {
            "cages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "cell_id",
                  "cage_type",
                  "antennas"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "cell_id": {
                    "type": "string"
                  },
                  "cage_type": {
                    "type": "string"
                  },
                  "antennas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^([0-9A-P]|TTL[1-4])-[1-9][0-9]*$"
                    }
                  }
                }
              }
            },
            "tunnels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "tunnel_no",
                  "start_cell_id",
                  "end_cell_id",
                  "dead_end",
                  "antenna_count",
                  "antennas",
                  "length"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tunnel_no": {
                    "type": "integer"
                  },
                  "start_cell_id": {
                    "type": "string"
                  },
                  "end_cell_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dead_end": {
                    "type": "boolean"
                  },
                  "antenna_count": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "antennas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^([0-9A-P]|TTL[1-4])-[1-9][0-9]*$"
                    },
                    "minItems": 1
                  },
                  "length": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "exclusiveMinimum": 0,
                    "description": "Centimetres between centres of the two main antennas on this tunnel; null if unknown or not applicable."
                  }
                }
              }
            },
            "junctions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "parent_tunnel",
                  "position"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "parent_tunnel": {
                    "type": "string"
                  },
                  "position": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  }
                }
              }
            },
            "antenna_combinations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tunnels_map": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "device_type",
              "antenna",
              "position",
              "TTL_port"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "antenna": {
                "type": "string",
                "pattern": "^[0-9A-P]-[1-9][0-9]*$"
              },
              "position": {
                "type": "string",
                "minLength": 1
              },
              "TTL_port": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^TTL[1-4]-[1-9][0-9]*$"
              },
              "device_type": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Optional device description; null when blank. Does not affect the generated name."
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical experiment configuration v7",
  "description": "Scientific metadata. No interpolated relations, GUI state, derived analysis origin, manifest, or preprocessing provenance. Datetimes may be null before recording; unresolved draft antennas fail this schema."
}
